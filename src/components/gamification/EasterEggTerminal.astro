      'icc': { name: 'ICC', desc: 'Tutarlılık Denetleyicisi - Otomatik veri tutarlılık doğrulama', url: '/tr/products/icc' },
      'retouch': { name: 'ReTouch', desc: 'Veri Girişi Yönetimi - Hızlı veri girişi platformu', url: '/tr/products/retouch' },
      'retable': { name: 'Retable', desc: 'Kodsuz Platform - Kod yazmadan veri uygulamaları kur', url: '/tr/products/retable' },
