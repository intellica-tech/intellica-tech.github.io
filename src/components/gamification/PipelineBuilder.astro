  @keyframes dmqSlideIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 768px) {
    .pb-insight__header, .pb-insight__body { padding-inline: 20px; }
    .pb-insight__title { font-size: 1.2rem; }
  }

  /* ── Reduced motion ────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .pb-canvas :global(.pb-node) {
      animation: none;
    }
    .pb-success__inner {
      animation: none;
    }
    .pb-canvas :global(.pb-particle--running) {
      opacity: 0;
    }
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 768px) {
    .pb-palettes {
      grid-template-columns: 1fr;
      gap: 16px;
