---
/**
 * PipelineBuilder.astro
 * Interactive visual pipeline builder where users click to add nodes
 * from source/transform/destination palettes. SVG bezier connections
 * with animated data flow particles on "Run Pipeline".
 */
import type { Lang } from '../../i18n/config';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;

// Palette definitions — names kept in English as standard data-engineering terminology
const sources = [
  { id: 'src-db', name: 'Database', iconId: 'cylinder' },
  { id: 'src-api', name: 'API', iconId: 'cloud' },
  { id: 'src-file', name: 'File', iconId: 'document' },
  { id: 'src-stream', name: 'Streaming', iconId: 'wave' },
];

const transforms = [
  { id: 'tr-filter', name: 'Filter', iconId: 'funnel' },
  { id: 'tr-join', name: 'Join', iconId: 'merge' },
  { id: 'tr-agg', name: 'Aggregate', iconId: 'stack' },
  { id: 'tr-ml', name: 'ML Model', iconId: 'brain' },
];

const destinations = [
  { id: 'dst-dw', name: 'Data Warehouse', iconId: 'db-stack' },
  { id: 'dst-dash', name: 'Dashboard', iconId: 'chart' },
  { id: 'dst-alert', name: 'Alert System', iconId: 'bell' },
  { id: 'dst-api', name: 'API Output', iconId: 'cloud-upload' },
];

const STRINGS = {
  en: {
    sectionLabel: 'INTERACTIVE DEMO',
    titlePrefix: 'Build Your ',
    titleHighlight: 'Pipeline',
    subtitle: 'Click components below to assemble a data pipeline. Connect sources, transforms, and destinations — then run it.',
    paletteSources: 'Sources',
    paletteTransforms: 'Transforms',
    paletteDestinations: 'Destinations',
    laneSources: 'Sources',
    laneTransforms: 'Transforms',
    laneDestinations: 'Destinations',
    emptyState: 'Click items above to add them to your pipeline',
    runBtn: 'Run Pipeline',
    runBtnAria: 'Run pipeline',
    successText: "Pipeline Ready! Let\u2019s build this for real.",
    successCta: 'Get Started',
    successCtaHref: '/contact',
    insightLabel: 'PIPELINE TYPE',
    insightUseCase: 'USE CASE',
    insightImpact: 'BUSINESS IMPACT',
    insightSolution: 'INTELLICA SOLUTION',
    toolbarAria: 'Pipeline component palettes',
    sourcesAria: 'Source components',
    transformsAria: 'Transform components',
    destinationsAria: 'Destination components',
    canvasAria: 'Pipeline canvas',
    addSourceTpl: 'Add {n} source',
    addTransformTpl: 'Add {n} transform',
    addDestinationTpl: 'Add {n} destination',
    removeTpl: 'Remove {n}',
    pipelineTypes: {
      ai: {
        title: 'AI-Enabled Pipeline',
        outcome: 'AI Enablement',
        useCase: 'Use machine learning models to predict behavior, detect patterns, and support automated decisions.',
        impact: ['Improve prediction accuracy', 'Enable smarter decision workflows', 'Prepare your platform for AI at scale'],
        solution: ['AI-ready data pipelines', 'ML model integration', 'Scalable data platform foundation'],
        cta: 'Discover AI Solutions \u2192',
        ctaUrl: '/solutions'
      },
      realtime: {
        title: 'Real-Time Pipeline',
        outcome: 'Real-Time Visibility',
        useCase: 'Ingest and process live data to support time-sensitive analytics and operational decisions.',
        impact: ['Reduce latency in decision-making', 'Improve visibility across channels', 'Respond faster to changing events'],
        solution: ['Real-time data ingestion', 'Streaming architecture design', 'Scalable processing pipelines'],
        cta: 'Explore Real-Time Platforms \u2192',
        ctaUrl: '/data-platforms'
      },
      monitoring: {
        title: 'Operational Monitoring Pipeline',
        outcome: 'Operational Intelligence',
        useCase: 'Track operational events continuously and trigger alerts when critical thresholds are reached.',
        impact: ['Detect issues earlier', 'Reduce operational risk', 'Improve SLA and service continuity'],
        solution: ['Event detection and alerting', 'Monitoring dashboards', 'Action management workflows'],
        cta: 'See Monitoring Solutions \u2192',
        ctaUrl: '/solutions'
      },
      batch: {
        title: 'Batch Analytics Pipeline',
        outcome: 'Analytics Foundation',
        useCase: 'Consolidate data from enterprise systems and transform it into trusted reporting and analysis.',
        impact: ['Build a single source of truth', 'Improve reporting consistency', 'Create a scalable analytics foundation'],
        solution: ['Enterprise data warehouse design', 'Data quality and consistency frameworks', 'Reporting and semantic layer'],
        cta: 'Learn About Data Platforms \u2192',
        ctaUrl: '/data-platforms'
      }
    }
  },
  tr: {
    sectionLabel: 'İNTERAKTİF DEMO',
    titlePrefix: 'Kendi ',
    titleHighlight: 'Pipeline\u2019ını Kur',
    subtitle: 'Veri pipeline\u2019ı oluşturmak için aşağıdaki bileşenlere tıklayın. Kaynakları, dönüşümleri ve hedefleri bağlayın — sonra çalıştırın.',
    paletteSources: 'Kaynaklar',
    paletteTransforms: 'Dönüşümler',
    paletteDestinations: 'Hedefler',
    laneSources: 'Kaynaklar',
    laneTransforms: 'Dönüşümler',
    laneDestinations: 'Hedefler',
    emptyState: 'Pipeline\u2019ınıza eklemek için yukarıdaki bileşenlere tıklayın',
    runBtn: 'Pipeline\u2019ı Çalıştır',
    runBtnAria: 'Pipeline\u2019ı çalıştır',
    successText: 'Pipeline hazır! Hadi gerçekten kuralım.',
    successCta: 'Başlayalım',
    successCtaHref: '/tr/contact',
    insightLabel: 'PIPELINE TİPİ',
    insightUseCase: 'KULLANIM SENARYOSU',
    insightImpact: 'İŞ ETKİSİ',
    insightSolution: 'INTELLICA ÇÖZÜMÜ',
    toolbarAria: 'Pipeline bileşen paletleri',
    sourcesAria: 'Kaynak bileşenler',
    transformsAria: 'Dönüşüm bileşenleri',
    destinationsAria: 'Hedef bileşenleri',
    canvasAria: 'Pipeline canvas\u2019ı',
    addSourceTpl: '{n} kaynağı ekle',
    addTransformTpl: '{n} dönüşümü ekle',
    addDestinationTpl: '{n} hedefi ekle',
    removeTpl: '{n} öğesini kaldır',
    pipelineTypes: {
      ai: {
        title: 'AI Destekli Pipeline',
        outcome: 'AI Etkinleştirme',
        useCase: 'Davranışları tahmin etmek, örüntüleri tespit etmek ve otomatik kararları desteklemek için makine öğrenimi modelleri kullanın.',
        impact: ['Tahmin doğruluğunu iyileştirir', 'Daha akıllı karar iş akışları sağlar', 'Platformunuzu ölçekte AI için hazırlar'],
        solution: ['AI\u2019a hazır veri pipeline\u2019ları', 'ML model entegrasyonu', 'Ölçeklenebilir veri platformu temeli'],
        cta: 'AI Çözümlerini Keşfet \u2192',
        ctaUrl: '/tr/solutions'
      },
      realtime: {
        title: 'Gerçek Zamanlı Pipeline',
        outcome: 'Gerçek Zamanlı Görünürlük',
        useCase: 'Zamana duyarlı analitik ve operasyonel kararları desteklemek için canlı veriyi alın ve işleyin.',
        impact: ['Karar verme süresini düşürür', 'Kanallar arası görünürlüğü iyileştirir', 'Değişen olaylara daha hızlı tepki verir'],
        solution: ['Gerçek zamanlı veri ingestion', 'Streaming mimarisi tasarımı', 'Ölçeklenebilir işleme pipeline\u2019ları'],
        cta: 'Gerçek Zamanlı Platformları Keşfet \u2192',
        ctaUrl: '/tr/data-platforms'
      },
      monitoring: {
        title: 'Operasyonel İzleme Pipeline\u2019ı',
        outcome: 'Operasyonel Zeka',
        useCase: 'Operasyonel olayları sürekli takip edin ve kritik eşiklere ulaşıldığında uyarı tetikleyin.',
        impact: ['Sorunları daha erken tespit eder', 'Operasyonel riski azaltır', 'SLA ve hizmet sürekliliğini iyileştirir'],
        solution: ['Olay tespiti ve uyarı', 'İzleme dashboard\u2019ları', 'Aksiyon yönetimi iş akışları'],
        cta: 'İzleme Çözümlerini Gör \u2192',
        ctaUrl: '/tr/solutions'
      },
      batch: {
        title: 'Batch Analitik Pipeline\u2019ı',
        outcome: 'Analitik Temeli',
        useCase: 'Kurumsal sistemlerden veriyi konsolide edip güvenilir raporlama ve analize dönüştürün.',
        impact: ['Tek doğruluk kaynağı oluşturur', 'Raporlama tutarlılığını iyileştirir', 'Ölçeklenebilir analitik temeli yaratır'],
        solution: ['Kurumsal veri ambarı tasarımı', 'Veri kalitesi ve tutarlılık çerçeveleri', 'Raporlama ve semantik katman'],
        cta: 'Veri Platformları Hakkında Bilgi Al \u2192',
        ctaUrl: '/tr/data-platforms'
      }
    }
  }
} as const;

const t = STRINGS[lang];
const fmt = (tpl: string, n: string) => tpl.replace('{n}', n);

// Serialize runtime strings for client JS
const clientStrings = JSON.stringify({
  removeTpl: t.removeTpl,
  emptyState: t.emptyState,
  pipelineTypes: t.pipelineTypes,
});
---

<section class="section section--light pb-section" id="pipeline-builder" data-pb-strings={clientStrings}>
  <div class="container">
    <!-- Section Header -->
    <div class="text-center anim-fade-up">
      <div class="section-label" style="margin-inline:auto;">{t.sectionLabel}</div>
      <h2 class="section-title">{t.titlePrefix}<span class="grad-text">{t.titleHighlight}</span></h2>
      <p class="section-sub">
        {t.subtitle}
      </p>
    </div>

    <!-- Palettes -->
    <div class="pb-palettes anim-fade-up" role="toolbar" aria-label={t.toolbarAria}>
      <!-- Sources Palette -->
      <div class="pb-palette" aria-label={t.sourcesAria}>
        <h3 class="pb-palette__title pb-palette__title--source">{t.paletteSources}</h3>
        <div class="pb-palette__items">
          {sources.map((s) => (
            <button
              class="pb-chip pb-chip--source"
              data-node-id={s.id}
              data-node-name={s.name}
              data-node-icon={s.iconId}
              data-lane="source"
              type="button"
              aria-label={fmt(t.addSourceTpl, s.name)}
            >
              <svg class="pb-chip__icon" viewBox="0 0 24 24" aria-hidden="true">
                <use href={`#pb-icon-${s.iconId}`} />
              </svg>
              <span class="pb-chip__label">{s.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Transforms Palette -->
      <div class="pb-palette" aria-label={t.transformsAria}>
        <h3 class="pb-palette__title pb-palette__title--transform">{t.paletteTransforms}</h3>
        <div class="pb-palette__items">
          {transforms.map((tr) => (
            <button
              class="pb-chip pb-chip--transform"
              data-node-id={tr.id}
              data-node-name={tr.name}
              data-node-icon={tr.iconId}
              data-lane="transform"
              type="button"
              aria-label={fmt(t.addTransformTpl, tr.name)}
            >
              <svg class="pb-chip__icon" viewBox="0 0 24 24" aria-hidden="true">
                <use href={`#pb-icon-${tr.iconId}`} />
              </svg>
              <span class="pb-chip__label">{tr.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Destinations Palette -->
      <div class="pb-palette" aria-label={t.destinationsAria}>
        <h3 class="pb-palette__title pb-palette__title--dest">{t.paletteDestinations}</h3>
        <div class="pb-palette__items">
          {destinations.map((d) => (
            <button
              class="pb-chip pb-chip--dest"
              data-node-id={d.id}
              data-node-name={d.name}
              data-node-icon={d.iconId}
              data-lane="destination"
              type="button"
              aria-label={fmt(t.addDestinationTpl, d.name)}
            >
              <svg class="pb-chip__icon" viewBox="0 0 24 24" aria-hidden="true">
                <use href={`#pb-icon-${d.iconId}`} />
              </svg>
              <span class="pb-chip__label">{d.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Canvas -->
    <div class="pb-canvas anim-fade-up" role="region" aria-label={t.canvasAria} aria-live="polite">
      <svg class="pb-canvas__svg" id="pb-svg" aria-hidden="true"></svg>
      <div class="pb-canvas__lanes">
        <div class="pb-lane" data-lane-type="source">
          <div class="pb-lane__label">{t.laneSources}</div>
          <div class="pb-lane__nodes" id="pb-lane-source"></div>
        </div>
        <div class="pb-lane" data-lane-type="transform">
          <div class="pb-lane__label">{t.laneTransforms}</div>
          <div class="pb-lane__nodes" id="pb-lane-transform"></div>
        </div>
        <div class="pb-lane" data-lane-type="destination">
          <div class="pb-lane__label">{t.laneDestinations}</div>
          <div class="pb-lane__nodes" id="pb-lane-destination"></div>
        </div>
      </div>
      <!-- Empty state -->
      <div class="pb-canvas__empty" id="pb-empty">
        <p>{t.emptyState}</p>
      </div>
    </div>

    <!-- Run Button + Success Message -->
    <div class="pb-actions anim-fade-up">
      <button
        class="btn btn-primary btn-pill btn-lg pb-run-btn"
        id="pb-run-btn"
        type="button"
        disabled
        aria-disabled="true"
        aria-label={t.runBtnAria}
      >
        <svg class="pb-run-btn__icon" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
          <polygon points="4,2 18,10 4,18" />
        </svg>
        {t.runBtn}
      </button>
      <div class="pb-success" id="pb-success" hidden aria-live="assertive">
        <div class="pb-success__inner">
          <svg class="pb-success__check" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="11" stroke="var(--clr-primary)" stroke-width="2" fill="none" />
            <polyline points="7,12 10,16 17,8" stroke="var(--clr-primary)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="pb-success__text">{t.successText}</p>
          <a class="btn btn-primary btn-pill" href={t.successCtaHref}>{t.successCta}</a>
        </div>
      </div>
    </div>

    <!-- Pipeline Insight Panel -->
    <div class="pb-insight anim-fade-up" id="pb-insight" hidden>
      <div class="pb-insight__card">
        <div class="pb-insight__header">
          <span class="pb-insight__label">{t.insightLabel}</span>
          <h3 class="pb-insight__title" id="pb-insight-title">{t.pipelineTypes.batch.title}</h3>
          <span class="pb-insight__outcome" id="pb-insight-outcome">{t.pipelineTypes.batch.outcome}</span>
        </div>
        <div class="pb-insight__body">
          <div class="pb-insight__section">
            <h4>{t.insightUseCase}</h4>
            <p id="pb-insight-usecase"></p>
          </div>
          <div class="pb-insight__section">
            <h4>{t.insightImpact}</h4>
            <ul id="pb-insight-impact"></ul>
          </div>
          <div class="pb-insight__section">
            <h4>{t.insightSolution}</h4>
            <ul id="pb-insight-solution"></ul>
          </div>
          <div class="pb-insight__cta">
            <a class="btn btn-primary btn-pill uppercase-never" id="pb-insight-cta-link" href={t.pipelineTypes.batch.ctaUrl}>{t.pipelineTypes.batch.cta}</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden SVG icon definitions -->
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none;" aria-hidden="true">
    <defs>
      <!-- Cylinder (Database) -->
      <symbol id="pb-icon-cylinder" viewBox="0 0 24 24">
        <ellipse cx="12" cy="6" rx="8" ry="3" stroke="currentColor" stroke-width="1.5" fill="none" />
        <path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6" stroke="currentColor" stroke-width="1.5" fill="none" />
        <ellipse cx="12" cy="12" rx="8" ry="3" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.4" />
      </symbol>
      <!-- Cloud (API) -->
      <symbol id="pb-icon-cloud" viewBox="0 0 24 24">
        <path d="M6 18a4 4 0 0 1-.8-7.92A6 6 0 0 1 18 9a5 5 0 0 1 .5 9.96" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
      <!-- Document (File) -->
      <symbol id="pb-icon-document" viewBox="0 0 24 24">
        <path d="M6 2h8l6 6v14H6z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round" />
        <path d="M14 2v6h6" stroke="currentColor" stroke-width="1.5" fill="none" />
        <line x1="9" y1="13" x2="15" y2="13" stroke="currentColor" stroke-width="1.5" />
        <line x1="9" y1="17" x2="13" y2="17" stroke="currentColor" stroke-width="1.5" />
      </symbol>
      <!-- Wave (Streaming) -->
      <symbol id="pb-icon-wave" viewBox="0 0 24 24">
        <path d="M2 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <path d="M2 7c2-4 4-4 6 0s4 4 6 0 4-4 6 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4" />
        <path d="M2 17c2-4 4-4 6 0s4 4 6 0 4-4 6 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4" />
      </symbol>
      <!-- Funnel (Filter) -->
      <symbol id="pb-icon-funnel" viewBox="0 0 24 24">
        <path d="M3 4h18l-7 8v6l-4 2V12z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round" />
      </symbol>
      <!-- Merge (Join) -->
      <symbol id="pb-icon-merge" viewBox="0 0 24 24">
        <path d="M6 4v6l6 6 6-6V4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="12" y1="16" x2="12" y2="22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </symbol>
      <!-- Stack (Aggregate) -->
      <symbol id="pb-icon-stack" viewBox="0 0 24 24">
        <polygon points="12,2 22,8 12,14 2,8" stroke="currentColor" stroke-width="1.5" fill="none" />
        <polyline points="2,12 12,18 22,12" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.6" />
        <polyline points="2,16 12,22 22,16" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.35" />
      </symbol>
      <!-- Brain (ML Model) -->
      <symbol id="pb-icon-brain" viewBox="0 0 24 24">
        <path d="M12 2a5 5 0 0 0-4.6 3A4.5 4.5 0 0 0 4 9.5a4.5 4.5 0 0 0 2 3.7V18a4 4 0 0 0 8 0h0a4 4 0 0 0 8 0v-4.8a4.5 4.5 0 0 0 2-3.7A4.5 4.5 0 0 0 16.6 5 5 5 0 0 0 12 2z" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0" />
        <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5" fill="none" />
        <circle cx="16" cy="8" r="3" stroke="currentColor" stroke-width="1.5" fill="none" />
        <circle cx="12" cy="16" r="3" stroke="currentColor" stroke-width="1.5" fill="none" />
        <line x1="9.5" y1="10.5" x2="10.5" y2="13.5" stroke="currentColor" stroke-width="1.2" />
        <line x1="14.5" y1="10.5" x2="13.5" y2="13.5" stroke="currentColor" stroke-width="1.2" />
        <line x1="8" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
      </symbol>
      <!-- DB Stack (Data Warehouse) -->
      <symbol id="pb-icon-db-stack" viewBox="0 0 24 24">
        <ellipse cx="12" cy="5" rx="8" ry="2.5" stroke="currentColor" stroke-width="1.5" fill="none" />
        <path d="M4 5v4c0 1.38 3.58 2.5 8 2.5s8-1.12 8-2.5V5" stroke="currentColor" stroke-width="1.5" fill="none" />
        <path d="M4 9v4c0 1.38 3.58 2.5 8 2.5s8-1.12 8-2.5V9" stroke="currentColor" stroke-width="1.5" fill="none" />
        <path d="M4 13v4c0 1.38 3.58 2.5 8 2.5s8-1.12 8-2.5v-4" stroke="currentColor" stroke-width="1.5" fill="none" />
      </symbol>
      <!-- Chart (Dashboard) -->
      <symbol id="pb-icon-chart" viewBox="0 0 24 24">
        <rect x="3" y="14" width="4" height="7" rx="0.5" stroke="currentColor" stroke-width="1.5" fill="none" />
        <rect x="10" y="8" width="4" height="13" rx="0.5" stroke="currentColor" stroke-width="1.5" fill="none" />
        <rect x="17" y="3" width="4" height="18" rx="0.5" stroke="currentColor" stroke-width="1.5" fill="none" />
      </symbol>
      <!-- Bell (Alert System) -->
      <symbol id="pb-icon-bell" viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
      </symbol>
      <!-- Cloud Upload (API Output) -->
      <symbol id="pb-icon-cloud-upload" viewBox="0 0 24 24">
        <path d="M6 18a4 4 0 0 1-.8-7.92A6 6 0 0 1 18 9a5 5 0 0 1 .5 9.96" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <polyline points="12,13 12,21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <polyline points="9,16 12,13 15,16" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
    </defs>
  </svg>
</section>

<style>
  /* ── Pipeline Builder ──────────────────────────── */
  .pb-section {
    overflow: hidden;
  }

  /* ── Palettes ──────────────────────────────────── */
  .pb-palettes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .pb-palette {
    background: var(--clr-light-card);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .pb-palette__title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid;
  }

  .pb-palette__title--source {
    color: var(--clr-secondary);
    border-color: var(--clr-secondary);
  }

  .pb-palette__title--transform {
    color: var(--clr-primary);
    border-color: var(--clr-primary);
  }

  .pb-palette__title--dest {
    color: #8B5CF6;
    border-color: #8B5CF6;
  }

  .pb-palette__items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ── Palette Chips ─────────────────────────────── */
  .pb-chip {
    display: inline-flex;
    align-items: center;
