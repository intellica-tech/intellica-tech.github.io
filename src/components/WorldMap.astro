<style>
  .world-map-wrap {
    margin-bottom: 32px;
  }

  .world-map-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Connection lines */
  .wm-conn {
    fill: none;
    stroke: #F97316;
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.5;
    stroke-linecap: round;
  }

  /* City dots */
  .wm-dot circle {
    fill: #F97316;
  }
  .wm-dot .wm-ring {
    fill: none;
    stroke: #F97316;
    stroke-width: 2;
    opacity: 0;
    animation: wm-pulse 2.5s ease-out infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes wm-pulse {
    0% { r: 5; opacity: 0.6; }
    100% { r: 20; opacity: 0; }
  }

  /* City labels */
  .wm-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    fill: #374151;
    letter-spacing: 0.02em;
  }
  .wm-label--hq {
    font-size: 14px;
    font-weight: 800;
    fill: #F97316;
  }

  /* City card */
  .wm-city-card text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    fill: #374151;
  }

  @media (max-width: 768px) {
    .wm-label { font-size: 9px; }
    .wm-label--hq { font-size: 10px; }
    .wm-city-card { display: none; }
  }
</style>
